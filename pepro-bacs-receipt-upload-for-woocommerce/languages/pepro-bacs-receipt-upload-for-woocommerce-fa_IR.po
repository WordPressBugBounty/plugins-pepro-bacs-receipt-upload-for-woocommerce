#. Plugin Name of the plugin
#: wc-upload-reciept.php wc-upload-reciept.php:898
msgid "PeproDev Receipt Uploader for WooCommerce"
msgstr "آپلود رسید پرداخت ووکامرس پپرو"

#. Plugin URI of the plugin
#: wc-upload-reciept.php
msgid "https://pepro.dev/receipt-upload"
msgstr "https://pepro.dev/wc-bacs-receipt-upload"

#. Description of the plugin
#: wc-upload-reciept.php
msgid ""
"Upload Receipt for Any Payment method in WooCommerce. Customers will Upload "
"the receipt (image/pdf) and Shop Managers will approve/reject it manually"
msgstr ""
"آپلود رسید سفارشات ووکامرسی برای درگاه های پرداخت دلخواه. کاربران میتوانند "
"رسید پرداخت را آپلود کرده و مدیر فروشگاه وضعیت رسید (تایید/رد) را مشخص کند"

#. Author of the plugin
#: wc-upload-reciept.php
msgid "Pepro Dev. Group"
msgstr "تیم توسعه پپرو"

#. Author URI of the plugin
#: wc-upload-reciept.php
msgid "https://pepro.dev/"
msgstr "https://pepro.dev/"

